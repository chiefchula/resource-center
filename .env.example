# Copy this file to .env and fill in real values.

FLASK_APP=run.py
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex

# SQLite (default). For Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/rescue_center
DATABASE_URL=sqlite:///rescue_center.db