# __pycache__/
# *.py[cod]
# *.sqlite
# *.db
# .env
# venv/
# .venv/
# instance/
# .vscode/
# .idea/

cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Flask
instance/
.webassets-cache/

# Environment files
.env
.env.local
.env.*.local

# SQLite databases
*.db
*.sqlite
*.sqlite3
instance/*.db

# Alembic (keep migrations/, ignore local cache)
migrations/__pycache__/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Backups
*.bak
*~
EOF